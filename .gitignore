# Ignore raw/intermediate/processed data files
data/raw/*
data/interim/*
data/processed/*

# Allow folder documentation/placeholders if you use them
!data/raw/README.md
!data/interim/README.md
!data/processed/README.md
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
